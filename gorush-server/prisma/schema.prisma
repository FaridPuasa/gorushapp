// Order/OrderHistory model shape for this shared gr_dms.orders / gr_dms.order_history
// table is OWNED by grfmxstatusupdate's prisma/schema.prisma — that file is the source
// of truth. This is a read/write CLIENT ONLY; NEVER run `prisma migrate dev/deploy`
// from this repo against these tables. Keep this file manually in sync whenever
// grfmxstatusupdate's schema.prisma changes shape for Order/OrderHistory.
//
// Only used for `npx prisma generate` here — schema changes belong in
// grfmxstatusupdate/prisma/schema.prisma, migrated from there, then mirrored here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (Supavisor, transaction mode) — used by the app
  directUrl = env("DIRECT_URL") // unpooled — used only if `prisma db pull` is ever run here
  schemas   = ["gr_dms"]
}

model Order {
  id      BigInt  @id @default(autoincrement())
  mongoId String? @unique @map("mongo_id")

  product                String?
  doTrackingNumber       String?   @map("do_tracking_number")
  jobDate                DateTime? @map("job_date")
  receiverName           String?   @map("receiver_name")
  receiverAddress        String?   @map("receiver_address")
  area                   String?
  patientNumber          String?   @map("patient_number")
  icPassNum              String?   @map("ic_pass_num")
  appointmentPlace       String?   @map("appointment_place")
  receiverPhoneNumber    String?   @map("receiver_phone_number")
  additionalPhoneNumber  String?   @map("additional_phone_number")
  deliveryTypeCode       String?   @map("delivery_type_code")
  remarks                String?
  paymentMethod          String?   @map("payment_method")
  dateTimeSubmission     DateTime? @map("date_time_submission")
  membership             String?
  icNum                  String?   @map("ic_num")
  items                  Json?
  ldCOD                  String?   @map("ld_cod")
  billTo                 String?   @map("bill_to")
  currency               String?
  passport               String?
  sequence               String?
  buyerName              String?   @map("buyer_name")
  startDate              DateTime? @map("start_date")
  addressLat             Decimal?  @map("address_lat") @db.Decimal(10, 7)
  cargoPrice             Decimal?  @map("cargo_price") @db.Decimal(12, 2)
  pickupDate             DateTime? @map("pickup_date")
  senderName             String?   @map("sender_name")
  totalPrice             Decimal?  @map("total_price") @db.Decimal(12, 2)
  addressLong            Decimal?  @map("address_long") @db.Decimal(10, 7)
  cubicMeters            Decimal?  @map("cubic_meters") @db.Decimal(10, 4)
  dateOfBirth            DateTime? @map("date_of_birth") @db.Date
  ldProductType          String?   @map("ld_product_type")
  ldCODAmount            Decimal?  @map("ld_cod_amount") @db.Decimal(12, 2)
  parcelWidth            Decimal?  @map("parcel_width") @db.Decimal(10, 2)
  senderEmail            String?   @map("sender_email")
  creationDate           DateTime? @map("creation_date")
  jobType                String?   @map("job_type")
  instructions           String?
  itemContains           String?   @map("item_contains")
  parcelHeight           Decimal?  @map("parcel_height") @db.Decimal(10, 2)
  parcelLength           Decimal?  @map("parcel_length") @db.Decimal(10, 2)
  parcelWeight           Decimal?  @map("parcel_weight") @db.Decimal(10, 2)
  supplierName           String?   @map("supplier_name")
  trackingLink           String?   @map("tracking_link")
  payingPatient          String?   @map("paying_patient")
  paymentAmount          Decimal?  @map("payment_amount") @db.Decimal(12, 2)
  pickupAddress          String?   @map("pickup_address")
  receiverEmail          String?   @map("receiver_email")
  senderAddress          String?   @map("sender_address")
  shipmentMethod         String?   @map("shipment_method")
  ldProductWeight        Decimal?  @map("ld_product_weight") @db.Decimal(10, 2)
  parcelTrackingNum      String?   @map("parcel_tracking_num")
  permitApplication      String?   @map("permit_application")
  senderPhoneNumber      String?   @map("sender_phone_number")
  ldPickupOrDelivery     String?   @map("ld_pickup_or_delivery")
  warehouseReference     String?   @map("warehouse_reference")
  appointmentDistrict    String?   @map("appointment_district")
  goRushReceivingCountry String?   @map("gorush_receiving_country")
  subscription           String?
  loyaltyPoints          Int?      @map("loyalty_points")
  pharmacyFormCreated    Boolean?  @map("pharmacy_form_created")
  sendOrderTo            String?   @map("send_order_to")
  itemCommodityType      String?   @map("item_commodity_type")
  screenshotInvoice      String?   @map("screenshot_invoice")
  currentStatus          String?   @map("current_status")
  lastUpdateDateTime     DateTime? @map("last_update_date_time")
  warehouseEntry         String?   @map("warehouse_entry")
  warehouseEntryDateTime DateTime? @map("warehouse_entry_date_time")
  queuedWarehouse        String?   @map("queued_warehouse")
  assignedTo             String?   @map("assigned_to")
  attempt                Int?
  flightDate             DateTime? @map("flight_date")
  mawbNo                 String?   @map("mawb_no")
  fmxMilestoneStatus     String?   @map("fmx_milestone_status")
  fmxMilestoneStatusCode String?   @map("fmx_milestone_status_code")
  latestReason           String?   @map("latest_reason")
  latestLocation         String?   @map("latest_location")
  lastUpdatedBy          String?   @map("last_updated_by")
  lastAssignedTo         String?   @map("last_assigned_to")
  receiverPostalCode     String?   @map("receiver_postal_code")
  jobMethod              String?   @map("job_method")
  room                   String?
  rackRowNum             String?   @map("rack_row_num")
  fridge                 String?
  grRemark               String?   @map("gr_remark")
  jpmcRemark             String?   @map("jpmc_remark")

  // Columns this app (gorush-server) actually populates on insert.
  bruhimsnum       String? @map("bruhimsnum")
  senderPostalCode String? @map("sender_postal_code")
  gorushUserId     String? @map("gorush_user_id")
  detrackJobId     String? @map("detrack_job_id")
  // Added to grfmxstatusupdate's schema/DB well before this app started
  // writing it (commit 09fa214) - never mirrored here, so every order
  // creation since that commit deployed has thrown a Prisma
  // "Unknown argument `orderOrigin`" validation error and failed outright.
  orderOrigin      String? @map("order_origin")

  // Not populated by gorush-server - mirrored here only to keep this file's shape
  // in sync with grfmxstatusupdate's own Order model (that schema is the source
  // of truth; see the header comment).
  detrackCompletedTime String? @map("detrack_completed_time")
  gdexPodConfirmedAt   String? @map("gdex_pod_confirmed_at")
  queueStatus          String? @map("queue_status")
  queueScheduledTime   String? @map("queue_scheduled_time")
  queueNote            String? @map("queue_note")

  podImage1Path String?   @map("pod_image_1_path")
  podImage2Path String?   @map("pod_image_2_path")
  podImage3Path String?   @map("pod_image_3_path")
  podUpdated    DateTime? @map("pod_updated")
  podSource     String?   @map("pod_source")

  // JPMC pharmacy client portal - populated by this app's own routes/jpmc.js,
  // read by gorush-client's /jpmc-portal. See grfmxstatusupdate's
  // schema.prisma (source of truth) for the authoritative column definitions.
  jpmcPharmacyStatus      String?   @map("jpmc_pharmacy_status")
  jpmcCompletedAt         DateTime? @map("jpmc_completed_at")
  jpmcFridgeItem          String?   @map("jpmc_fridge_item")
  jpmcPatientInformed     String?   @map("jpmc_patient_informed")
  jpmcPharmacyRemarks     String?   @map("jpmc_pharmacy_remarks")
  jpmcTotalAmount         Decimal?  @map("jpmc_total_amount") @db.Decimal(12, 2)
  jpmcFinanceDateReceived DateTime? @map("jpmc_finance_date_received")
  jpmcPaymentProofPath    String?   @map("jpmc_payment_proof_path")
  jpmcFieldsUpdatedBy     String?   @map("jpmc_fields_updated_by")
  jpmcFieldsUpdatedAt     DateTime? @map("jpmc_fields_updated_at")

  history OrderHistory[]

  @@index([parcelTrackingNum])
  @@index([mawbNo])
  @@index([receiverPostalCode])
  @@index([icPassNum])
  @@index([patientNumber])
  @@index([bruhimsnum])
  @@index([gorushUserId])
  @@index([jobMethod])
  @@index([product])
  @@index([assignedTo])
  @@index([area])
  @@index([currentStatus])
  @@index([latestReason])
  @@index([paymentMethod])
  @@index([latestLocation])
  @@index([jobDate])
  @@index([creationDate])
  @@index([product, lastUpdateDateTime])
  @@map("orders")
  @@schema("gr_dms")
}

model OrderHistory {
  id             BigInt    @id @default(autoincrement())
  orderId        BigInt    @map("order_id")
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  statusHistory  String?   @map("status_history")
  dateUpdated    DateTime? @map("date_updated")
  updatedBy      String?   @map("updated_by")
  lastAssignedTo String?   @map("last_assigned_to")
  reason         String?
  lastLocation   String?   @map("last_location")

  @@index([statusHistory, dateUpdated])
  @@map("order_history")
  @@schema("gr_dms")
}

// Owned by grfmxstatusupdate's own prisma/schema.prisma - mirrored here only
// for this app's direct write path (routes/wargaEmasOrders.js). Keep in sync
// with that file's WaOrder model if it ever changes shape - see this
// repo's header comment on the Order model above for why this mirroring is
// necessary (a missing field here silently breaks every insert with a
// PrismaClientValidationError, not caught until it happens live).
model WaOrder {
  id      BigInt  @id @default(autoincrement())
  mongoId String? @unique @map("mongo_id")

  icPictureFront      String?   @map("ic_picture_front")
  icPictureBack       String?   @map("ic_picture_back")
  dateTimeSubmission  DateTime? @map("date_time_submission")
  receiverPhoneNumber String?   @map("receiver_phone_number")

  @@map("wa_orders")
  @@schema("gr_dms")
}

// Everything below this point is genuinely OWNED by this app (gorush-server) -
// unlike Order/OrderHistory/WaOrder above, no other app reads or writes these
// collections, so THIS repo is the right place to run migrations for them
// (`npx prisma migrate dev` / `db push`), not just `prisma generate`.

model Announcement {
  id      BigInt  @id @default(autoincrement())
  mongoId String? @unique @map("mongo_id")

  titleEn                String?  @map("title_en")
  bodyEn                 String?  @map("body_en")
  titleBm                String?  @map("title_bm")
  bodyBm                 String?  @map("body_bm")
  date                   String?
  bodyAlign              String?  @map("body_align")
  showOnBannerToGuests   Boolean? @map("show_on_banner_to_guests")
  showOnBannerToLoggedIn Boolean? @map("show_on_banner_to_logged_in")

  @@map("announcements")
  @@schema("gr_dms")
}

model Vacancy {
  id      BigInt  @id @default(autoincrement())
  mongoId String? @unique @map("mongo_id")

  title            String?
  department       String?
  employmentType   String?   @map("employment_type")
  description      String?
  requirements     String?
  responsibilities String?
  applicationType  String?   @map("application_type")
  isOpen           Boolean?  @map("is_open")
  closingDate      String?   @map("closing_date")
  order            Int?
  createdAt        DateTime? @map("created_at")

  @@map("vacancies")
  @@schema("gr_dms")
}

model HeroSlide {
  id      BigInt  @id @default(autoincrement())
  mongoId String? @unique @map("mongo_id")

  image    String?
  headline String?
  subtext  String?
  linkUrl  String? @map("link_url")
  order    Int?

  @@map("heroslides")
  @@schema("gr_dms")
}

// Read directly by grfmxstatusupdate too (GorushPricingRule/GorushPublicHoliday
// read-only mirror models) - unlike Announcement/Vacancy/HeroSlide, this pair
// needs BOTH apps' reads coordinated together before any read-cutover, not
// just a one-sided dual-write. This phase is still write-side only (Mongo
// stays primary here too); the read-cutover is a separate, later decision -
// see the gorushapp Mongo migration phasing memory. This is also the exact
// collection pair that caused the 2026-08-31 strictQuery reorder-pricing
// incident in grfmxstatusupdate.
model PricingRule {
  id      BigInt  @id @default(autoincrement())
  mongoId String? @unique @map("mongo_id")

  product    String?
  district   String?
  chargeCode String? @map("charge_code")
  price      Float?
  note       String?

  @@unique([product, district, chargeCode])
  @@map("pricing_rules")
  @@schema("gr_dms")
}

model PublicHoliday {
  id      BigInt  @id @default(autoincrement())
  mongoId String? @unique @map("mongo_id")

  date  String?
  label String?

  @@map("public_holidays")
  @@schema("gr_dms")
}

// 2026-09-16: first step of gorushapp's own Mongo write-cutover (grfmxstatusupdate's
// side finished 2026-09-15 - see that repo's migration_status.md). Confirmed the
// `jobapplications` Mongo collection has zero real documents as of this writing, so
// no backfill is needed - dual-write starts clean. userId/vacancyId are stored as
// plain mongoId-style strings (not real Postgres FKs) - same loose-reference
// convention as every other mongoId column in this schema, since neither User nor
// Vacancy's own Postgres migration is guaranteed to be ahead of this one. icFront/
// resumeCv/drivingLicenseFront/drivingLicenseBack are large base64 data URIs, stored
// as plain String (Postgres TEXT) for now - same "not the final destination, just
// stops the Mongo write" bridge-storage decision grfmxstatusupdate made for its own
// POD images the day before, not a proper Storage-bucket migration.
model JobApplication {
  id      BigInt  @id @default(autoincrement())
  mongoId String? @unique @map("mongo_id")

  userId    String? @map("user_id")
  vacancyId String? @map("vacancy_id")

  positionApplied String? @map("position_applied")
  applicationType String? @map("application_type")

  name        String?
  dateofbirth String?
  icnumber    String?
  houseunitno String?
  jalan       String?
  kampong     String?
  simpang     String?
  district    String?
  postalcode  String?
  email       String?
  phonenum    String?
  addphonenum String?

  highestAchievement String? @map("highest_achievement")
  partTimeDuration   String? @map("part_time_duration")
  carOwn             String? @map("car_own")
  deliverBefore      String? @map("deliver_before")
  experienceDelivery String? @map("experience_delivery")
  parcelNum          String? @map("parcel_num")
  driveManual        String? @map("drive_manual")

  // 2026-09-16: retired in favor of the Storage-backed *Path columns below -
  // real destination now, see lib/jobApplicationDocsStorage.js (same private-
  // bucket pattern as lib/podImageStorage.js's POD photos and
  // lib/jpmcPaymentStorage.js's payment proofs). Kept only as a read-side
  // safety net for the brief window right before this migration deployed.
  icFront             String? @map("ic_front")
  resumeCv            String? @map("resume_cv")
  drivingLicenseFront String? @map("driving_license_front")
  drivingLicenseBack  String? @map("driving_license_back")

  icFrontPath             String? @map("ic_front_path")
  resumeCvPath            String? @map("resume_cv_path")
  drivingLicenseFrontPath String? @map("driving_license_front_path")
  drivingLicenseBackPath  String? @map("driving_license_back_path")

  status             String?
  dateTimeSubmission String?   @map("date_time_submission")
  createdAt          DateTime? @map("created_at")

  @@map("job_applications")
  @@schema("gr_dms")
}

// 2026-09-16: dual-write phase (last item of the "cutting all Mongo ties"
// plan). Mongo (`grusers` collection, model name `User`) stays primary -
// this is purely an additive mirror, gated behind SUPABASE_USER_ENABLED, see
// lib/userDualWrite.js. Table named `website_users` (NOT `users`) because
// grfmxstatusupdate's OWN schema.prisma already owns a table literally
// called `users` in this same gr_dms schema for its internal staff/admin
// accounts - a completely unrelated concept from gorushapp's website
// customers (email/password signup to place orders). Embedded Mongo arrays
// (addresses/phonenumbers/additionalphonenumbers/userdetails) become real
// child tables here since Postgres has no native embedded-array equivalent;
// each child row's own `mongoId` is the embedded subdocument's Mongoose
// `_id` (used throughout routes/profile.js for .id()/.pull() lookups), kept
// only for traceability - the dual-write helper fully deletes and recreates
// all child rows on every sync rather than diffing them individually, since
// every profile write in routes/profile.js already ends in `user.save()`
// with the complete final array state in memory (auth.js's UserSchema.post
// ('save') hook is the single call site for all of this - see models/User.js).
model User {
  id      BigInt  @id @default(autoincrement())
  mongoId String? @unique @map("mongo_id")

  email            String?
  password         String?
  role             String?
  agreePolicy      Boolean?  @map("agree_policy")
  receiveMarketing Boolean?  @map("receive_marketing")
  createdAt        DateTime? @map("created_at")

  addresses              UserAddress[]
  phonenumbers           UserPhoneNumber[]
  additionalPhonenumbers UserAdditionalPhoneNumber[]
  userdetails            UserDetail[]

  @@map("website_users")
  @@schema("gr_dms")
}

model UserAddress {
  id      BigInt  @id @default(autoincrement())
  mongoId String? @unique @map("mongo_id")
  userId  BigInt  @map("user_id")
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  houseunitno String?
  jalan       String?
  kampong     String?
  simpang     String?
  district    String?
  postalcode  String?
  isDefault   Boolean? @map("is_default")

  @@map("website_user_addresses")
  @@schema("gr_dms")
}

model UserPhoneNumber {
  id      BigInt  @id @default(autoincrement())
  mongoId String? @unique @map("mongo_id")
  userId  BigInt  @map("user_id")
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  phonenum  String?
  isDefault Boolean? @map("is_default")

  @@map("website_user_phone_numbers")
  @@schema("gr_dms")
}

// Flat list, no isDefault - matches models/User.js's additionalphonenumbers
// sub-schema exactly (no default concept for these, unlike addresses/
// phonenumbers/userdetails).
model UserAdditionalPhoneNumber {
  id      BigInt  @id @default(autoincrement())
  mongoId String? @unique @map("mongo_id")
  userId  BigInt  @map("user_id")
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  addphonenum String?

  @@map("website_user_additional_phone_numbers")
  @@schema("gr_dms")
}

model UserDetail {
  id      BigInt  @id @default(autoincrement())
  mongoId String? @unique @map("mongo_id")
  userId  BigInt  @map("user_id")
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  receivername        String?
  dateofbirth          String?
  icnum                String?
  passportnum          String?
  bruhimsnum           String?
  appointmentdistrict  String?
  patientphcnum        String?
  patientjpmcnum       String?
  appointmentplace     String?
  payingpatient        String?
  isDefault            Boolean? @map("is_default")

  @@map("website_user_details")
  @@schema("gr_dms")
}
